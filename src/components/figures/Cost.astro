---
import Figure from "../Figure.astro";
---
<Figure width="wide">
  <Fragment slot="controls">
    <div class="seg" id="cxm"><button data-m="cost" class="on">Dollars</button><button data-m="calls">Model calls</button></div>
  </Fragment>
  <div class="chart" id="cost"></div>
  <div class="legend" id="costleg"></div>
  <Fragment slot="caption">
    <b>Figure 4.</b> Best score so far against model spend for six runs from scratch, labelled with run, final score
    and total spend. Every run gets within 1% of the best known value for a few cents.
  </Fragment>
</Figure>
