---
import Figure from "../Figure.astro";
---
<Figure width="wide">
  <div class="chart" id="chart"></div>
  <div class="legend" id="chartleg"></div>
  <Fragment slot="caption">
    <b>Best score by deme</b>, on the same scale as the relief. Each line is the best program a deme holds; the
    thick line is the whole population.
  </Fragment>
</Figure>
<Figure width="wide">
  <div class="split">
    <div>
      <p class="lab">Attempts that moved the record · click a row for its code change</p>
      <div class="scroll"><table><thead><tr><th>Attempt</th><th>Score</th><th>Move</th><th class="ideah">The bet</th></tr></thead><tbody id="recs"></tbody></table></div>
      <p class="caption" id="demonote"></p>
    </div>
    <div class="panel"><p class="dtitle" id="dtitle"></p><pre class="diff" id="diff"></pre></div>
  </div>
</Figure>
