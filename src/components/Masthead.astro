---
import { SITE, AUTHORS } from "../data/site";
---
<header class="masthead" id="top">
  <p class="kicker">SCiEL · research in progress</p>
  <h1>Let Them Get Better at Getting Better<span class="sub">Recursive Self-Improvement (RSI) through Cultural Transmission</span></h1>
  <p class="authors">
    {AUTHORS.map((a, i) => (
      <Fragment>
        {i > 0 && <span class="sep" aria-hidden="true">·</span>}
        {a.href ? <a href={a.href} target="_blank" rel="noopener">{a.name}</a> : <span>{a.name}</span>}
      </Fragment>
    ))}
  </p>
  <div class="orgs">
    <a href="https://cpil-lab.github.io/" target="_blank" rel="noopener"><img src="/img/cpil.png" alt="" width="34" height="34" />CPIL Research Group</a>
    <a href="https://mbzuai.ac.ae/" target="_blank" rel="noopener"><img src="/img/mbzuai.png" alt="" width="34" height="34" />MBZUAI</a>
  </div>
  <p class="meta">{SITE.date}</p>
  <div class="buttons">
    <a class="off" href="#" aria-disabled="true"><svg class="ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h6"/></svg>Preprint · in progress</a>
    <a href="https://github.com/SCiEL-RSI-CPIL/sciel-rsi-framework" target="_blank" rel="noopener"><svg class="ico" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>Code</a>
    <a href="https://research-arena.small-pine-3af7.workers.dev" target="_blank" rel="noopener"><svg class="ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4"/><path d="M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/></svg>Arena</a>
    <a href="https://huggingface.co/datasets/autoresearchTasksSciel/autoresearch-tasks" target="_blank" rel="noopener"><svg class="ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/></svg>Dataset</a>
    <a href="#cite"><svg class="ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 7H6a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h3v1a3 3 0 0 1-3 3"/><path d="M20 7h-4a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h3v1a3 3 0 0 1-3 3"/></svg>Cite</a>
  </div>
</header>
