---
// P1: the original page body, ported as-is so each figure can be checked against the legacy page.
// The layout and text are replaced in P2/P3; the figures (src/figures) carry over.
import body from "../port/body.html?raw";
import { SITE, AUTHORS, BIBTEX_AUTHORS } from "../data/site";
import "../styles/legacy.css";
import "../styles/figure-theme.css";

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const authorsHtml = AUTHORS.map((a) =>
  a.href
    ? `<a class="au" href="${esc(a.href)}" target="_blank" rel="noopener">${esc(a.name)}</a>`
    : `<span class="au">${esc(a.name)}</span>`,
).join(" · ");
const html = body.replace("<!--AUTHORS-->", authorsHtml).replace("<!--BIBAUTHORS-->", esc(BIBTEX_AUTHORS));

const description =
  "SCiEL: recursive self-improvement (RSI) through cultural transmission. Demes of programs and research cells learn, pass on what survives a trial at the recipient, and every decision is a randomized experiment on the system itself.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: SITE.title,
  author: AUTHORS.map((a) => ({ "@type": "Person", name: a.name, ...(a.href ? { url: a.href } : {}) })),
  publisher: { "@type": "Organization", name: "CPIL Research Group, MBZUAI" },
  about: "recursive self-improvement (RSI)",
  url: SITE.url,
  image: SITE.ogImage,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.title} · {SITE.shortTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHORS.map((a) => a.name).join(", ")} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={SITE.url} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE.shortTitle} />
    <meta property="og:title" content={SITE.title} />
    <meta property="og:description" content="Recursive self-improvement (RSI) through cultural transmission. Research ongoing; every figure is drawn from real runs." />
    <meta property="og:image" content={SITE.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={SITE.url} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Fragment set:html={html} />
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
