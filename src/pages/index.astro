---
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/source-serif-4/wght-italic.css";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/site.css";
import "../styles/figures.css";

import Masthead from "../components/Masthead.astro";
import TocRail from "../components/TocRail.astro";
import Article from "../content/article.mdx";
import { SITE, AUTHORS } from "../data/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: SITE.title,
  description: SITE.description,
  author: AUTHORS.map((a) => ({ "@type": "Person", name: a.name, ...(a.href ? { url: a.href } : {}) })),
  publisher: { "@type": "Organization", name: "CPIL Research Group, MBZUAI" },
  about: "recursive self-improvement (RSI)",
  url: SITE.url,
  image: SITE.ogImage,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.title} · {SITE.shortTitle}</title>
    <meta name="description" content={SITE.description} />
    <meta name="author" content={AUTHORS.map((a) => a.name).join(", ")} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={SITE.url} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE.shortTitle} />
    <meta property="og:title" content={SITE.title} />
    <meta property="og:description" content={SITE.description} />
    <meta property="og:image" content={SITE.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Let Them Get Better at Getting Better: recursive self-improvement through cultural transmission." />
    <meta property="og:url" content={SITE.url} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={SITE.title} />
    <meta name="twitter:description" content={SITE.description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#idea">Skip to content</a>

    <Masthead />

    <TocRail />

    <main class="article">
      <Article />
    </main>

    <footer class="site">
      <div class="foot-in">
        <div class="foot-orgs">
          <a href="https://cpil-lab.github.io/" target="_blank" rel="noopener"><img src="/img/cpil.png" alt="" width="22" height="22" />CPIL Research Group</a>
          <a href="https://mbzuai.ac.ae/" target="_blank" rel="noopener"><img src="/img/mbzuai.png" alt="" width="22" height="22" />MBZUAI</a>
        </div>
        <p>
          Figures are drawn from SCiEL runs with Qwen3.8-27B served locally, processed with the same code as the run viewer.
          The runs are in the <a href="https://research-arena.small-pine-3af7.workers.dev/experiments" target="_blank" rel="noopener">Empira arena</a>.
          The preprint is in progress; for questions and collaborations, write to any of the authors.
        </p>
        <nav class="foot-links" aria-label="Links">
          <a href="https://github.com/SCiEL-RSI-CPIL/sciel-rsi-framework" target="_blank" rel="noopener">Code</a>
          <a href="https://sciel-cpil.github.io/sciel-results/" target="_blank" rel="noopener">Results</a>
          <a href="#cite">Cite</a>
          <a href="#top">Back to top ↑</a>
        </nav>
      </div>
    </footer>

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
